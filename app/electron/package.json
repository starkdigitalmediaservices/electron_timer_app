{
  "name": "pms-desktop",
  "version": "0.0.1",
  "description": "This pms desktop app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev:watch": "npx electronmon --trace-warnings .",
    "build:react": "cd .. && npm --prefix ./ run build-react",
    "build:electron": "electron-builder",
    "build:all": "npm run build:react && npm run build:electron"
  },
  "build": {
    "appId": "com.pmsDesktop",
    "productName": "pmsDesktop",
    "extends": null,
    "asar": true,
    "asarUnpack": [],
    "files": [
      "main.js",
      "node_modules",
      "preload.js",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "./node_modules/electron/dist/ffmpeg.dll",
        "to": "ffmpeg.dll"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis",
      "icon": "../assets/icon.ico",
      "sign": null
    },
    "linux": {
      "target": "AppImage",
      "icon": "../assets"
    }
  },
  "keywords": [
    "electron",
    "reactjs",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^33.3.1",
    "electron-builder": "^24.8.0",
    "electronmon": "^2.0.3",
    "react-scripts": "^5.0.1"
  }
}
