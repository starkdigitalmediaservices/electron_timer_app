{
  "name": "pms-desktop",
  "version": "0.0.1",
  "description": "This pms desktop app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev:watch": "npx electronmon --trace-warnings .",
    "build:react": "npm run build",  
    "build:electron": "electron-builder",
    "build:all": "npm run build:react && npm run build:electron"
  },
  "build": {
    "appId": "com.pmsDesktop",
    "productName": "pmsDesktop",
    "files": [
      "build/**/*",
      "main.js",
      "node_modules/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "keywords": [
    "electron",
    "reactjs",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^33.3.1",
    "electron-builder": "^24.8.0",
    "electronmon": "^4.0.1"
  }
}
